# Copy the names into your host's environment settings. Never commit real values.
# See docs/DEPLOY-RENDER.md.

# Postgres connection string (set automatically by the Render Blueprint)
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated emails allowed to manage the website
SCHOOL_ADMIN_EMAILS=office@example.com
# The secondary school principal, JSS 1 to SS 3: opens /principal only (no office access unless also in SCHOOL_ADMIN_EMAILS).
SCHOOL_PRINCIPAL_EMAILS=
# The primary school principal, Year 1 to Year 6: opens /principal/primary only (no office access unless also in SCHOOL_ADMIN_EMAILS).
SCHOOL_PRIMARY_PRINCIPAL_EMAILS=
# The exam officer: opens /exam-officer. When set, every exam waits for the exam officer to publish it.
SCHOOL_EXAM_OFFICER_EMAILS=
# The Chairman: opens /chairman, a read-only board of the whole school (no money; cannot send or change anything).
SCHOOL_CHAIRMAN_EMAILS=
# The bursar: opens /accounts to record school income and spending (spending waits for the school owner to approve).
SCHOOL_BURSAR_EMAILS=
# The staff AI assistant (Claude): a key from console.anthropic.com. Off until set. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: questions per staff member per day (default 40).
ASSISTANT_DAILY_LIMIT=
# The Head of School: opens /head and every portal, and emails teachers and parents (an administrator too).
SCHOOL_HEAD_EMAILS=
# Optional: emails the Director and Head of School may send in 24 hours (default 500).
SCHOOL_EMAIL_DAILY_LIMIT=
# Super administrator(s) who can read the audit log; defaults to the first admin email
SCHOOL_SUPER_ADMIN_EMAILS=
# true = administrators must turn on Clerk two-factor before access (enable MFA in Clerk first)
REQUIRE_ADMIN_MFA=false
# true = enforce the Content-Security-Policy (otherwise report-only)
# The Content-Security-Policy is enforced. Only set CSP_REPORT_ONLY=true as a temporary emergency switch.
CSP_REPORT_ONLY=false

# Email (Resend) for activation and password-reset links
RESEND_API_KEY=
# Parent portal: Paystack secret key (Paystack dashboard > Settings > API Keys & Webhooks). Never commit it.
# Webhook URL to enter in Paystack: https://<your domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
EMAIL_FROM=New World Emerald <portal@yourdomain.com>
# Public address used in emailed links (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_SITE_URL=

# Clerk keys from your own Clerk application
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Cloudinary media storage (recommended): copy "API environment variable" from the
# Cloudinary dashboard, without the CLOUDINARY_URL= part. Takes priority over the bucket.
CLOUDINARY_URL=

# After the school domain shows this site, set to true to send the onrender.com address there.
FORWARD_TO_DOMAIN=

# Clerk webhook signing secret (whsec_...): Clerk's sign-in emails are sent through Resend.
CLERK_WEBHOOK_SIGNING_SECRET=

# Google Cloud Storage (outside Replit): service account key as JSON or base64
GCS_SERVICE_ACCOUNT_JSON=
PRIVATE_OBJECT_DIR=/your-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# Serve the built website from the API (single-service hosting such as Render)
FRONTEND_DIST_DIR=artifacts/new-world-emerald/dist/public
